# 이 파일은 참고용이다. 실제 개발 기본값은 커밋된 .env.development 에 있다.
# 개인 설정으로 덮어쓰려면 .env.local 을 만든다 (git 무시됨).

# API 기본 경로.
# /api 로 두면 vite dev 프록시(-> http://127.0.0.1:8000)를 탄다.
# 프록시 없이 직접 호출하려면 전체 URL을 적는다 (백엔드 CORS_ORIGINS 에 프론트 주소가 있어야 한다).
VITE_API_BASE_URL=/api

# 목 API 사용 여부.
# false : 실제 백엔드로 요청을 보낸다 (기본)
# true  : 백엔드 없이 브라우저 안에서 API를 흉내 낸다 (demo@example.com / demo1234)
VITE_USE_MOCK=false
