# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env
# .env 는 .gitignore 에 있어서 git 에 올라가지 않습니다.

# --- 데이터베이스 ---
DATABASE_URL=mysql+mysqldb://<사용자>:<비밀번호>@127.0.0.1/fastapi-ca

# --- JWT ---
# 아무 값이나 쓰지 말고 아래 명령으로 만든 랜덤 값을 넣으세요.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# 이 값이 유출되면 누구나 ADMIN 토큰을 위조할 수 있습니다.
JWT_SECRET_KEY=<32자 이상 랜덤 문자열>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=6

# --- CORS ---
# 프론트엔드가 뜨는 주소를 쉼표로 구분해 적습니다 (Vite 기본 포트가 5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
